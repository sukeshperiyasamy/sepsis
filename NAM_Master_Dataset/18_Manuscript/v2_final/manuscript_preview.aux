\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Photostability of N-acetylmuramic acid powder under 785\nobreakspace  {}nm excitation. (a) Ten consecutive scans at 90\% laser power and 30\nobreakspace  {}s integration, same spot: the spectra are indistinguishable. (b) Five consecutive scans at 90\% power and 60\nobreakspace  {}s integration, same spot, with the reference spectrum shown for comparison: the sample is destroyed. (c) Normalised intensity of the 930\nobreakspace  {}\ensuremath  {\mathrm  {cm}^{-1}}{} band across consecutive scans for both conditions.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:photostab}{{3}{7}{Photostability of N-acetylmuramic acid powder under 785~nm excitation. (a) Ten consecutive scans at 90\% laser power and 30~s integration, same spot: the spectra are indistinguishable. (b) Five consecutive scans at 90\% power and 60~s integration, same spot, with the reference spectrum shown for comparison: the sample is destroyed. (c) Normalised intensity of the 930~\wn {} band across consecutive scans for both conditions}{figure.3}{}}
